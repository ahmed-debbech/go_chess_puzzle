    },
    {
      "id": "X9FHwFzs9oc4B7ujhA3EO",
      "type": "text",
      "x": 694.2317184688013,
      "y": -325.8273170199733,
      "width": 765.7992553710938,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "at",
      "roundness": null,
      "seed": 2094256060,
      "version": 807,
      "versionNonce": 620497540,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1731584896724,
      "link": null,
      "locked": false,
      "text": "GENERATION Desc:\n1 * use cutter to split large pgn files into smaller pgn fle for each match\n2 * store all the files in the disk with each match file labeled by id\n3 * fire up generator.go to start a generation instance of puzzles\n4 * generator.go will communicate with stockfish engine to generate best move\n5 * storer.go will keep  listening for generator.go for generated matches\n6 * storer.go should store all generated match in a mongodb instance",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GENERATION Desc:\n1 * use cutter to split large pgn files into smaller pgn fle for each match\n2 * store all the files in the disk with each match file labeled by id\n3 * fire up generator.go to start a generation instance of puzzles\n4 * generator.go will communicate with stockfish engine to generate best move\n5 * storer.go will keep  listening for generator.go for generated matches\n6 * storer.go should store all generated match in a mongodb instance",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wfaOAd3SeJffzQYHs42hz",
      "type": "text",
      "x": 691.576122736652,
      "y": -122.09077446176923,
      "width": 862.5991821289062,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "au",
      "roundness": null,
      "seed": 1683804420,
      "version": 442,
      "versionNonce": 429922820,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1731584896724,
      "link": null,
      "locked": false,
      "text": "SERVING Desc:\n1 * backend.go communicates with mongodb to load matches for each load of a page\n2 * backend.go will accept all moves from client frontend and checks against best moves\n    and responds",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SERVING Desc:\n1 * backend.go communicates with mongodb to load matches for each load of a page\n2 * backend.go will accept all moves from client frontend and checks against best moves\n    and responds",
      "autoResize": true,
      "lineHeight": 1.25
    },
