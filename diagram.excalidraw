      "boundElements": [],
      "updated": 1731584896724,
      "link": null,
      "locked": false,
      "text": "1 * client loads page and immediately get already-generated puzzle randomly\n2 * client play a move and sends to server for validation\n3 * server checks user input against best move in the db and responds\n4 a * if client refreshes page go back to step 1\n4 b - a * if move is correct and still moves\n         * client keeps sending correct moves til the end\n4 b - b * if client move is correct and no more moves\n         * go back to step 1",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 * client loads page and immediately get already-generated puzzle randomly\n2 * client play a move and sends to server for validation\n3 * server checks user input against best move in the db and responds\n4 a * if client refreshes page go back to step 1\n4 b - a * if move is correct and still moves\n         * client keeps sending correct moves til the end\n4 b - b * if client move is correct and no more moves\n         * go back to step 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
